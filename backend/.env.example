# Server-side fallback keys — only used if a client doesn't supply its own (BYOK) key.
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# Comma-separated origins allowed to call this API. Defaults to local dev ports if unset.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
